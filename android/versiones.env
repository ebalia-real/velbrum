# Versión de IronFox sobre la que se arma Velbrum para Android (ver
# android/reempaquetar.py y README.md, «Android»). Al subirla, revisar que
# android/prueba.py siga pasando en el emulador.
IRONFOX=158.0.2
# Huella SHA-256 del certificado con el que IronFox firma sus APK (la publica
# en su README: https://gitlab.com/ironfox-oss/IronFox). IronFox no publica
# firmas GPG: lo que se baja se acepta solo si el APK está firmado con este
# certificado (apksigner verifica la firma de todo el archivo).
IRONFOX_CERTIFICADO=c5e291b5a571f9c8cd9a9799c2c94e02ec9703948893f2ca756d67b94204f904
# ID de la aplicación de Velbrum en Android (no se puede cambiar sin que
# quien lo instaló pierda sus datos).
PAQUETE=io.github.ebalia_real.velbrum
# Herramientas del workflow (.github/workflows/android.yml). La suma de
# apktool coincide con la que fija nixpkgs para la misma versión.
APKTOOL=2.12.1
APKTOOL_SHA256=66cf4524a4a45a7f56567d08b2c9b6ec237bcdd78cee69fd4a59c8a0243aeafa
BUILD_TOOLS=35.0.0
